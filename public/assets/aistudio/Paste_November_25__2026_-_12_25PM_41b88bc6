    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return defaultState();
        const parsed = JSON.parse(raw);
        return { ...defaultState(), ...parsed, modal: null };
      } catch (e) {
        return defaultState();
      }
    }

    let state = loadState();
    function saveState() {
      const toSave = { ...state, modal: null };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(toSave));
    }

    /* =========================================================================
       5. NAVEGACIÓ I GESTIÓ DE CONTEXT
       ========================================================================= */
    function currentView() {
      return state.viewStack[state.viewStack.length - 1] || { type: 'home' };
    }

    function pushView(view) {
      state.viewStack.push(view);
      state.mapZoom = 1;
      saveState();
      render();
    }

    function replaceView(view) {
      state.viewStack[state.viewStack.length - 1] = view;
      state.mapZoom = 1;
      saveState();
      render();
    }

    function popView() {
      if (state.viewStack.length > 1) {
        state.viewStack.pop();
        state.mapZoom = 1;
        saveState();
        render();
      }
    }

    function enterStore(storeId) {
      state.activeStoreId = storeId;
      state.recentStores = [storeId, ...state.recentStores.filter(id => id !== storeId)].slice(0, 4);
      state.activeTab = 'cerca';
      state.viewStack = [{ type: 'storeSearch', storeId, query: '' }];
      saveState();
      render();
    }

    function switchTab(tab) {
      state.activeTab = tab;
      if (tab === 'inici') {
        state.viewStack = [{ type: 'home' }];
      } else if (tab === 'cerca') {
        if (state.activeStoreId) {
          state.viewStack = [{ type: 'storeSearch', storeId: state.activeStoreId, query: '' }];
        } else {
          state.viewStack = [{ type: 'globalStoreSearch', query: '' }];
        }
      } else if (tab === 'llistes') {
        state.viewStack = [{ type: 'listsHome' }];
      } else if (tab === 'devolucions') {
        state.viewStack = [{ type: 'returnsHome' }];
      } else if (tab === 'perfil') {
        state.viewStack = [{ type: 'profile' }];
      }
