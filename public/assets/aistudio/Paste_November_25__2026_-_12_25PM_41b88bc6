          </div>

          <div class="section-label">Productes pendents de retornar (${pending.length})</div>
          ${pending.length === 0 ? `
            <div class="empty-state">
              No tens cap producte pendent de retornar!<br/>
              Pots marcar qualsevol producte per retornar des de la seva fitxa.
            </div>
          ` : pending.map(r => {
            const store = STORES[r.storeId];
            const p = CATALOGS[r.storeId].find(x => x.id === r.productId);
