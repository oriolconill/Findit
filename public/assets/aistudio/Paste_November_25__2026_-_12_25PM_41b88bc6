              F
            </div>
            <div>
              <div style="font-size:17px;font-weight:800;">Usuari FINDIT</div>
              <div style="font-size:13px;color:var(--text-secondary);">Compte local · Dades sincronitzades</div>
            </div>
          </div>

          <div class="btn-grid-2" style="margin-bottom:14px;">
            <div class="card" style="text-align:center;">
              <div style="font-size:24px;font-weight:800;color:var(--blue-primary);">${state.stats.listsCompleted}</div>
              <div style="font-size:12px;color:var(--text-secondary);font-weight:600;">Llistes completades</div>
