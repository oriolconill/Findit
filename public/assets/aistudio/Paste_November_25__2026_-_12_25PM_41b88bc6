    }

    /* =========================================================================
       9. DEVOLUCIONS
       ========================================================================= */
    function renderReturnsHome() {
      const pending = state.returns.filter(r => r.status === 'pending');

      return `
        ${renderTopBar('Devolucions', 'Retorna productes a la seva ubicació original', false)}
        <main class="main-content fade-in">
          <div class="card" style="background:var(--blue-light);border-color:#BFDBFE;margin-bottom:14px;">
            <div style="font-size:13px;font-weight:700;color:var(--blue-dark);">
              Cada producte s'ha de retornar a la seva prestatgeria o expositor original dins de l'establiment.
