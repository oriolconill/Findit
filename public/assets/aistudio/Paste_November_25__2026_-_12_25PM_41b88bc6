    function renderListComplete(view) {
      const { storeId } = view;
      const store = STORES[storeId];
      const items = optimizeListItems(storeId, state.lists[storeId] || []);
      const total = items.length;
      const found = items.filter(i => i.found).length;

      return `
        ${renderTopBar('Recorregut completat', store.name, false)}
        <main class="main-content fade-in">
          <div class="card" style="text-align:center;padding:24px 16px;">
            <div style="width:76px;height:76px;border-radius:50%;background:var(--success-bg);color:var(--success);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:34px;font-weight:800;">
              ✓
            </div>
            <div class="badge badge-avail" style="margin-bottom:8px;">100% COMPLETAT</div>
            <h2 style="font-size:22px;font-weight:800;color:var(--text-primary);margin-bottom:6px;">HAS COMPLETAT LA TEVA LLISTA!</h2>
            <p style="font-size:14px;color:var(--text-secondary);margin-bottom:16px;">
