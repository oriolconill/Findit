    /* =========================================================================
       10. PERFIL I CONFIGURACIÓ
       ========================================================================= */
    function renderProfile() {
      const store = state.activeStoreId ? STORES[state.activeStoreId] : null;
      const pendingReturns = state.returns.filter(r => r.status === 'pending').length;

      return `
        ${renderTopBar('Perfil', 'Informació i preferències de l\'usuari', false)}
        <main class="main-content fade-in">
          <div class="card" style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
