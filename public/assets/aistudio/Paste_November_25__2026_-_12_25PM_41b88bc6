    }

    /* =========================================================================
       11. ACCIONS INTERACTIVES
       ========================================================================= */
    function updateCurrentQuery(val) {
      const v = currentView();
      v.query = val;
      saveState();
      render(true);
    }

    function updateListAddQuery(val) {
      const v = currentView();
      v.addQuery = val;
      saveState();
      render(true);
    }

    function setDetailVariant(key, val) {
      const v = currentView();
      v[key] = val;
      saveState();
      render();
    }

    function adjustZoom(delta) {
      state.mapZoom = Math.min(2.0, Math.max(0.8, +(state.mapZoom + delta).toFixed(1)));
      render();
    }

    function addProductToStoreList(storeId, productId, variantLabel, stayInList = false) {
      const uid = 'li-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6);
      state.lists[storeId] = state.lists[storeId] || [];
      state.lists[storeId].push({ uid, productId, variantLabel, found: false });

      if (stayInList) {
        currentView().addQuery = '';
        saveState();
        render();
      } else {
        saveState();
        showToast(`Afegit a la llista de ${STORES[storeId].name}`);
      }
    }

    function removeListItem(storeId, uid) {
      state.lists[storeId] = state.lists[storeId].filter(i => i.uid !== uid);
      saveState();
      render();
    }

    function markTourItemFound(storeId, itemUid, fromSubScreen) {
      const list = state.lists[storeId] || [];
      const item = list.find(i => i.uid === itemUid);
      if (item) item.found = true;

      const optimized = optimizeListItems(storeId, list).filter(i => !i.unlocatable);
      const nextPending = optimized.find(i => !i.found);

      if (fromSubScreen && state.viewStack.length > 1) {
        state.viewStack.pop();
      }

      if (!nextPending) {
        state.activeTour = null;
        state.stats.listsCompleted += 1;
        saveState();
        replaceView({ type: 'listComplete', storeId });
      } else {
        state.activeTour = { storeId, currentUid: nextPending.uid, paused: false };
        saveState();
        render();
      }
    }

    function skipTourItem(storeId, currentUid) {
      const optimized = optimizeListItems(storeId, state.lists[storeId] || []).filter(i => !i.unlocatable && !i.found);
      if (optimized.length <= 1) {
        showToast('És l\'últim producte pendent!');
        return;
      }
      const idx = optimized.findIndex(i => i.uid === currentUid);
      const next = optimized[(idx + 1) % optimized.length];
      state.activeTour = { storeId, currentUid: next.uid, paused: false };
      saveState();
      render();
    }

    function pauseTour(storeId) {
      if (state.activeTour) state.activeTour.paused = true;
      saveState();
      popView();
    }

    function confirmDeleteList(storeId) {
      state.modal = {
        title: 'Eliminar llista',
        message: 'Vols eliminar aquesta llista? Aquesta acció no es pot desfer.',
        confirmText: 'Eliminar definitivament',
        onConfirm: `executeDeleteList('${storeId}')`
      };
      render();
    }

    function executeDeleteList(storeId) {
      state.lists[storeId] = [];
      state.activeTour = null;
      state.modal = null;
      state.activeTab = 'llistes';
      state.viewStack = [{ type: 'listsHome' }];
      saveState();
      render();
    }

    function saveListAsTemplate(storeId) {
      const items = (state.lists[storeId] || []).map(i => ({
        productId: i.productId,
        variantLabel: i.variantLabel
      }));
      if (items.length === 0) return;

      const store = STORES[storeId];
      const count = state.templates.filter(t => t.storeId === storeId).length + 1;
      state.templates.unshift({
        id: 'tpl-' + Date.now(),
        storeId,
        name: `Compra habitual ${store.name} #${count}`,
        createdAt: Date.now(),
        items
      });
      state.activeTour = null;
      saveState();
      state.activeTab = 'llistes';
      state.viewStack = [{ type: 'listsHome' }];
      render();
      showToast('Plantilla guardada per a futures compres!');
    }

    function startFromTemplate(tplId) {
      const tpl = state.templates.find(t => t.id === tplId);
      if (!tpl) return;
      state.lists[tpl.storeId] = tpl.items.map((it, idx) => ({
        uid: 'tpl-item-' + Date.now() + '-' + idx,
        productId: it.productId,
        variantLabel: it.variantLabel,
        found: false
      }));
      state.activeTour = null;
      saveState();
      openListDetail(tpl.storeId);
    }

    function deleteTemplate(tplId) {
      state.templates = state.templates.filter(t => t.id !== tplId);
      saveState();
      render();
    }

    function addProductToReturns(storeId, productId, variantLabel) {
      state.returns.unshift({
        id: 'ret-' + Date.now(),
        storeId,
        productId,
        variantLabel,
        status: 'pending'
      });
      saveState();
      showToast('Producte afegit a Devolucions');
      render();
    }

    function completeReturnItem(returnId) {
      state.returns = state.returns.filter(r => r.id !== returnId);
      state.stats.returnsCompleted += 1;
      state.activeTab = 'devolucions';
      state.viewStack = [{ type: 'returnsHome' }];
      saveState();
      render();
      showToast('Producte retornat a la seva ubicació original!');
    }

    function exitActiveStore() {
      state.activeStoreId = null;
      saveState();
      render();
    }

    function resetAllDemoData() {
      localStorage.removeItem(STORAGE_KEY);
      state = defaultState();
      saveState();
      render();
      showToast('Dades de demostració restablertes');
    }

    function closeModal() {
      state.modal = null;
      render();
    }

    let toastTimer = null;
    function showToast(msg) {
      let el = document.getElementById('findit-toast');
      if (!el) {
        el = document.createElement('div');
        el.id = 'findit-toast';
        el.style.cssText = 'position:absolute;bottom:84px;left:50%;transform:translateX(-50%);background:#202A36;color:#fff;padding:10px 16px;border-radius:999px;font-size:13px;font-weight:600;z-index:60;box-shadow:0 6px 20px rgba(0,0,0,0.2);white-space:nowrap;';
        document.getElementById('app').appendChild(el);
      }
      el.textContent = msg;
      el.style.display = 'block';
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { el.style.display = 'none'; }, 2400);
    }

    /* =========================================================================
       12. MENÚ INFERIOR FIX I RENDER PRINCIPAL
       ========================================================================= */
    function renderBottomNav() {
      const pendingReturns = state.returns.filter(r => r.status === 'pending').length;
      const tabs = [
        { id: 'inici', label: 'Inici', icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
        { id: 'cerca', label: 'Cerca', icon: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' },
        { id: 'llistes', label: 'Llistes', icon: '<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>' },
        { id: 'devolucions', label: 'Devolucions', badge: pendingReturns, icon: '<polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/>' },
        { id: 'perfil', label: 'Perfil', icon: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>' }
      ];

      return `
        <nav class="bottom-nav">
          ${tabs.map(t => `
            <button class="nav-item ${state.activeTab === t.id ? 'active' : ''}" onclick="switchTab('${t.id}')">
              ${t.badge ? `<span class="nav-badge">${t.badge}</span>` : ''}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">${t.icon}</svg>
              <span>${t.label}</span>
            </button>
          `).join('')}
        </nav>
      `;
    }

    function render(preserveInputFocus = false) {
      const activeEl = preserveInputFocus ? document.activeElement : null;
      const activeId = activeEl ? activeEl.id : null;
      const selStart = activeEl && typeof activeEl.selectionStart === 'number' ? activeEl.selectionStart : null;

      const v = currentView();
      let bodyHtml = '';
      switch (v.type) {
        case 'home': bodyHtml = renderHome(); break;
        case 'globalStoreSearch': bodyHtml = renderGlobalStoreSearch(v); break;
        case 'qrScan': bodyHtml = renderQrScan(); break;
        case 'detectStore': bodyHtml = renderDetectStore(); break;
        case 'storeSearch': bodyHtml = renderStoreSearch(v); break;
        case 'categoryProducts': bodyHtml = renderCategoryProducts(v); break;
        case 'productDetail': bodyHtml = renderProductDetail(v); break;
        case 'directions': bodyHtml = renderDirections(v); break;
        case 'productMap': bodyHtml = renderProductMap(v); break;
        case 'storeMapOnly': bodyHtml = renderStoreMapOnly(v); break;
        case 'listsHome': bodyHtml = renderListsHome(); break;
        case 'listDetail': bodyHtml = renderListDetail(v); break;
        case 'fullListMap': bodyHtml = renderFullListMap(v); break;
        case 'listTour': bodyHtml = renderListTour(v); break;
        case 'listComplete': bodyHtml = renderListComplete(v); break;
        case 'returnsHome': bodyHtml = renderReturnsHome(); break;
        case 'profile': bodyHtml = renderProfile(); break;
        default: bodyHtml = renderHome();
      }

      const modalHtml = state.modal ? `
        <div class="modal-backdrop">
          <div class="modal-box fade-in">
            <h3 style="font-size:18px;font-weight:800;margin-bottom:8px;">${state.modal.title}</h3>
            <p style="font-size:14px;color:var(--text-secondary);line-height:1.45;margin-bottom:18px;">${state.modal.message}</p>
            <div style="display:flex;flex-direction:column;gap:8px;">
              <button class="btn btn-danger-outline" onclick="${state.modal.onConfirm}">${state.modal.confirmText}</button>
              <button class="btn btn-outline" onclick="closeModal()">Cancel·lar</button>
            </div>
          </div>
        </div>
      ` : '';

      document.getElementById('app').innerHTML = bodyHtml + renderBottomNav() + modalHtml;

      if (preserveInputFocus && activeId) {
        const nextInput = document.getElementById(activeId);
        if (nextInput) {
          nextInput.focus();
          if (selStart !== null) nextInput.setSelectionRange(selStart, selStart);
        }
      }
    }

    // Arrencada inicial
    render();
  </script>
</body>
</html>

Què inclou aquesta implementació?

  - Identitat visual exacta: paleta blava corporativa (#246BCE, #174A91,
    #EAF3FF, #F5F9FF), tipografia Inter, targetes arrodonides, colors
    diferenciats per categoria i disseny mobile-first amb barra inferior fixa
    de 5 apartats (Inici, Cerca, Llistes, Devolucions, Perfil).
  - Pantalla inicial i selecció d'establiment: cerca exclusiva d'establiments,
    simuladors funcionals d'Escaneig QR i Detecció per GPS, i historial d'Els
    teus últims establiments en ordre cronològic invers.
  - 4 establiments amb dades i catàlegs independents: Mercadona, Zara,
    Biblioteca de Vilanova i Decathlon, amb les seves categories, variants de
    talla/color i ubicacions exactes.
  - Cerca intel·ligent: tolera coincidències parcials des de les primeres
    lletres («Lle», «Iog», «Sab», «Cami»), ignora accents i majúscules, reconeix
    singulars/plurals i sinònims, i diferencia visualment les categories dels
    productes.
  - Mapes 2D i rutes reals sense travessar obstacles: algorisme de camí més curt
    (BFS sobre graella transitable) per als 4 plànols diferenciats, marcador «TU
    ETS AQUÍ», zoom interactiu i instruccions pas a pas generades a partir del
    recorregut real.
  - Llistes amb optimització automàtica i flux continu: càlcul automàtic de la
    ruta més eficient pels passadissos (sense botó manual), mapa del recorregut
    complet amb parades numerades, i flux continu on «PRODUCTE TROBAT» apareix
    directament dins de Com arribar-hi i Veure mapa i avança automàticament al
    següent producte. Inclou pantalla de finalització amb opció d'eliminar (amb
    confirmació) o guardar com a plantilla reutilitzable.
  - Devolucions: flux complet adaptat fins a la ubicació original de cada
    producte amb el botó directe «PRODUCTE RETORNAT» dins de les indicacions i
    el mapa.
