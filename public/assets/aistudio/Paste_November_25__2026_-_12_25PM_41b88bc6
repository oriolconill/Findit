                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;flex-wrap:wrap;">
                      <span class="badge" style="background:${store.color};color:#fff;">${store.name}</span>
                      <span class="badge badge-low">Pendent de retornar</span>
                    </div>
                    <div style="font-size:15px;font-weight:800;">${p.name}</div>
                    <div style="font-size:12px;color:var(--text-secondary);margin-top:2px;">
                      Ubicació original: <strong style="color:var(--blue-dark);">${p.aisle} · ${p.shelf} · ${p.level}</strong>
                    </div>
                  </div>
                </div>
                <button class="btn btn-primary btn-sm" style="width:100%;" onclick="openProductDetail('${r.storeId}', '${p.id}', 'return', { returnId: '${r.id}' })">
