          <span style="position:absolute;bottom:0;left:0;right:0;height:4px;background:${cat.color};"></span>
        </div>
      `;
    }

    function renderStoreMapSVG(storeId, options = {}) {
      const store = STORES[storeId];
      const { cols, rows, zones } = store.map;
      const cell = 28;
      const W = cols * cell;
      const H = rows * cell;

      const {
        targetZone = null,
        singlePath = null,
        multiStops = null, // [{ zone, index, found, label }]
        zoom = 1
      } = options;

      // Construir ruta multiparada si és mapa de llista completa
      let multiPathPoints = [];
      if (multiStops && multiStops.length > 0) {
        let cur = store.entrance;
        for (const stop of multiStops) {
          const seg = findGridPath(store, cur, stop.zone.approach);
          if (multiPathPoints.length > 0) seg.shift();
          multiPathPoints = multiPathPoints.concat(seg);
          cur = stop.zone.approach;
        }
      }

      const toPx = (pt) => `${(pt.x + 0.5) * cell},${(pt.y + 0.5) * cell}`;
      const pathStr = singlePath ? singlePath.map(toPx).join(' ') : (multiPathPoints.length ? multiPathPoints.map(toPx).join(' ') : '');

      const zonesSvg = zones.map(z => {
        const isTarget = targetZone && targetZone.id === z.id;
        return `
          <g>
            <rect x="${z.x * cell + 2}" y="${z.y * cell + 2}" width="${z.w * cell - 4}" height="${z.h * cell - 4}"
              rx="6" fill="${z.color}" stroke="${isTarget ? '#246BCE' : z.border}" stroke-width="${isTarget ? 3 : 1.5}" />
            <text x="${(z.x + z.w / 2) * cell}" y="${(z.y + z.h / 2) * cell + 3}"
              text-anchor="middle" font-size="9.5" font-weight="700" fill="#1E293B" font-family="Inter, sans-serif">
              ${z.label}
            </text>
          </g>
        `;
      }).join('');

      // Marcador de destinació únic
      let targetPinSvg = '';
      if (targetZone) {
        const px = targetZone.pin.x * cell;
        const py = targetZone.pin.y * cell;
        targetPinSvg = `
          <g>
            <circle cx="${px}" cy="${py}" r="14" fill="#246BCE" opacity="0.22">
              <animate attributeName="r" values="10;18;10" dur="1.6s" repeatCount="indefinite" />
            </circle>
            <circle cx="${px}" cy="${py}" r="8" fill="#246BCE" stroke="#FFFFFF" stroke-width="2.5" />
            <circle cx="${px}" cy="${py}" r="3" fill="#FFFFFF" />
          </g>
        `;
      }

      // Parades numerades per a mapa de llista completa
      let stopsSvg = '';
      if (multiStops && multiStops.length > 0) {
        // Agrupar lleugerament si coincideixen al mateix pin
        const seenCoords = {};
        stopsSvg = multiStops.map(st => {
          const key = `${st.zone.id}`;
          const offsetIdx = seenCoords[key] || 0;
          seenCoords[key] = offsetIdx + 1;
          const px = st.zone.pin.x * cell + (offsetIdx * 15 - (offsetIdx > 0 ? 7 : 0));
          const py = st.zone.pin.y * cell - (offsetIdx * 8);
          const fill = st.found ? '#16A34A' : '#246BCE';
          return `
            <g>
              <circle cx="${px}" cy="${py}" r="10.5" fill="${fill}" stroke="#FFFFFF" stroke-width="2" />
              <text x="${px}" y="${py + 3.5}" text-anchor="middle" font-size="10" font-weight="800" fill="#FFFFFF" font-family="Inter, sans-serif">${st.index}</text>
            </g>
          `;
        }).join('');
      }

      const ex = (store.entrance.x + 0.5) * cell;
      const ey = (store.entrance.y + 0.5) * cell;

      return `
        <svg viewBox="0 0 ${W} ${H}" style="width:${Math.round(100 * zoom)}%;min-width:340px;height:auto;display:block;background:#F8FAFC;">
          <defs>
            <pattern id="gridPat" width="${cell}" height="${cell}" patternUnits="userSpaceOnUse">
              <path d="M ${cell} 0 L 0 0 0 ${cell}" fill="none" stroke="#E2E8F0" stroke-width="0.6" />
            </pattern>
          </defs>
          <!-- Zones transitables (passadissos) -->
          <rect x="0" y="0" width="${W}" height="${H}" fill="url(#gridPat)" />
          <rect x="2" y="2" width="${W - 4}" height="${H - 4}" fill="none" stroke="#94A3B8" stroke-width="3" rx="8" />

          <!-- Prestatgeries, expositors i obstacles -->
          ${zonesSvg}

          <!-- Línia de ruta blava -->
          ${pathStr ? `
            <polyline points="${pathStr}" fill="none" stroke="#246BCE" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="8 6" />
          ` : ''}

          <!-- Marcador TU ETS AQUÍ (Entrada) -->
          <g>
            <circle cx="${ex}" cy="${ey}" r="11" fill="#174A91" stroke="#FFFFFF" stroke-width="2.5" />
            <text x="${ex}" y="${ey + 3}" text-anchor="middle" font-size="9" font-weight="800" fill="#FFFFFF">TU</text>
            <rect x="${ex - 36}" y="${ey - 27}" width="72" height="15" rx="4" fill="#174A91" />
            <text x="${ex}" y="${ey - 17}" text-anchor="middle" font-size="8" font-weight="800" fill="#FFFFFF">TU ETS AQUÍ</text>
          </g>

          ${targetPinSvg}
          ${stopsSvg}
        </svg>
      `;
    }

