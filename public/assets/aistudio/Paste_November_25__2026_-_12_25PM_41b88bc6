            <div class="card" style="text-align:center;">
              <div style="font-size:24px;font-weight:800;color:var(--success);">${state.stats.returnsCompleted}</div>
              <div style="font-size:12px;color:var(--text-secondary);font-weight:600;">Devolucions fetes</div>
            </div>
          </div>

          <div class="card" style="margin-bottom:14px;">
            <div style="font-size:14px;font-weight:800;margin-bottom:6px;">Establiment actual</div>
            <div style="font-size:13px;color:var(--text-secondary);margin-bottom:10px;">
              ${store ? `Actualment estàs dins de <strong>${store.name}</strong>.` : 'No hi ha cap establiment seleccionat.'}
            </div>
            ${store ? `
              <button class="btn btn-light btn-sm" style="width:100%;" onclick="exitActiveStore()">Sortir de ${store.name}</button>
            ` : `
