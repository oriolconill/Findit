        ? { source: 'return', returnId, storeId, productId }
        : { source: 'search', storeId, productId };

      return `
        ${renderTopBar(source === 'return' ? 'Devolució de producte' : 'Fitxa del producte', store.name)}
        <main class="main-content fade-in">
          <div class="card" style="text-align:center;">
            <div style="display:flex;justify-content:center;margin-bottom:14px;">
              ${renderProductArt(storeId, p, 112)}
            </div>
            <div style="display:flex;justify-content:center;gap:6px;margin-bottom:8px;flex-wrap:wrap;">
              <span class="badge ${availBadge}">${p.availability}</span>
              <span class="badge badge-price">${p.category}</span>
            </div>
            <h2 style="font-size:20px;font-weight:800;line-height:1.25;margin-bottom:4px;">${p.name}</h2>
            <div style="font-size:14px;color:var(--text-secondary);margin-bottom:10px;">
              ${p.brand} · ${p.format}
            </div>
            <div style="font-size:24px;font-weight:800;color:var(--blue-primary);">${priceText}</div>

            ${p.variants ? `
              <div style="text-align:left;margin-top:14px;padding-top:14px;border-top:1px solid var(--border-soft);">
                ${p.variants.sizes ? `
                  <div style="font-size:12px;font-weight:700;color:var(--text-secondary);">Talla / Format</div>
                  <div class="chip-row" style="margin-bottom:10px;">
                    ${p.variants.sizes.map(sz => `
                      <button class="chip ${selectedSize === sz ? 'selected' : ''}" onclick="setDetailVariant('selectedSize', '${sz}')">${sz}</button>
                    `).join('')}
                  </div>
                ` : ''}
                ${p.variants.colors ? `
                  <div style="font-size:12px;font-weight:700;color:var(--text-secondary);">Color</div>
                  <div class="chip-row">
                    ${p.variants.colors.map(cl => `
                      <button class="chip ${selectedColor === cl ? 'selected' : ''}" onclick="setDetailVariant('selectedColor', '${cl}')">${cl}</button>
                    `).join('')}
                  </div>
                ` : ''}
              </div>
            ` : ''}

            <!-- Ubicació exacta destacada -->
            <div class="location-box" style="text-align:left;">
              <div class="location-label">${source === 'return' ? 'Ubicació original dins de l\'establiment' : 'Ubicació exacta'}</div>
              <div class="location-value">${p.aisle} · ${p.section} · ${p.shelf} · ${p.level}</div>
            </div>

            <!-- Botons independents Com arribar-hi i Veure mapa -->
            <div class="btn-grid-2">
              <button class="btn btn-primary" onclick='openDirections(${JSON.stringify(ctx)})'>
                Com arribar-hi
              </button>
              <button class="btn btn-dark" onclick='openProductMap(${JSON.stringify(ctx)})'>
                Veure mapa
              </button>
            </div>
          </div>

          ${source !== 'return' ? `
            <div class="card" style="margin-top:12px;display:flex;flex-direction:column;gap:8px;">
              <button class="btn btn-light" onclick="addProductToStoreList('${storeId}', '${p.id}', '${[selectedSize, selectedColor].filter(Boolean).join(' · ') || p.format}')">
                + Afegir a la meva llista de ${store.name}
              </button>
              <button class="btn btn-outline" onclick="addProductToReturns('${storeId}', '${p.id}', '${[selectedSize, selectedColor].filter(Boolean).join(' · ') || p.format}')">
                Marcar per retornar a aquesta ubicació
              </button>
            </div>
          ` : ''}
        </main>
      `;
    }

    function openDirections(ctx) {
      pushView({ type: 'directions', ctx });
    }

    function openProductMap(ctx) {
      pushView({ type: 'productMap', ctx });
    }

    function renderDirections(view) {
      const { ctx } = view;
      const store = STORES[ctx.storeId];
      const p = CATALOGS[ctx.storeId].find(x => x.id === ctx.productId);
      const { steps, zone } = generateWrittenDirections(ctx.storeId, p);

      let actionFooter = '';
      if (ctx.source === 'list') {
        actionFooter = `
          <div class="floating-cta">
            <button class="btn btn-success" onclick="markTourItemFound('${ctx.storeId}', '${ctx.itemUid}', true)">
              ✓ PRODUCTE TROBAT
            </button>
          </div>
        `;
      } else if (ctx.source === 'return') {
        actionFooter = `
          <div class="floating-cta">
            <button class="btn btn-success" onclick="completeReturnItem('${ctx.returnId}')">
              ✓ PRODUCTE RETORNAT
            </button>
          </div>
        `;
      }

      return `
        ${renderTopBar('Com arribar-hi', `${store.name} · ${p.name}`)}
        <main class="main-content fade-in">
          <div class="card" style="margin-bottom:14px;display:flex;align-items:center;gap:12px;">
            ${renderProductArt(ctx.storeId, p, 54)}
            <div style="flex:1;min-width:0;">
              <div style="font-size:15px;font-weight:800;">${p.name}</div>
              <div style="font-size:12px;color:var(--blue-primary);font-weight:700;margin-top:2px;">
                ${p.aisle} · ${p.section} · ${p.shelf} · ${p.level}
              </div>
            </div>
          </div>

          <div class="section-label">Indicacions pas a pas (${zone.label})</div>
          ${steps.map((txt, idx) => `
            <div class="step-item">
              <div class="step-num">${idx + 1}</div>
              <div style="font-size:14px;font-weight:500;line-height:1.45;color:var(--text-primary);">${txt}</div>
            </div>
          `).join('')}

          ${ctx.source === 'search' ? `
            <button class="btn btn-light" style="margin-top:8px;" onclick='replaceView({ type: "productMap", ctx: ${JSON.stringify(ctx)} })'>
              Veure recorregut al mapa 2D
            </button>
          ` : ''}

          ${actionFooter}
        </main>
      `;
    }

    function renderProductMap(view) {
      const { ctx } = view;
      const store = STORES[ctx.storeId];
      const p = CATALOGS[ctx.storeId].find(x => x.id === ctx.productId);
      const { zone, path } = generateWrittenDirections(ctx.storeId, p);

      let actionFooter = '';
      if (ctx.source === 'list') {
        actionFooter = `
          <div class="floating-cta">
            <button class="btn btn-success" onclick="markTourItemFound('${ctx.storeId}', '${ctx.itemUid}', true)">
              ✓ PRODUCTE TROBAT
            </button>
          </div>
        `;
      } else if (ctx.source === 'return') {
        actionFooter = `
          <div class="floating-cta">
            <button class="btn btn-success" onclick="completeReturnItem('${ctx.returnId}')">
              ✓ PRODUCTE RETORNAT
            </button>
          </div>
        `;
      }

      return `
        ${renderTopBar('Mapa de l\'establiment', `${store.name} · ${p.name}`)}
        <main class="main-content fade-in">
          <div class="location-box" style="margin-top:0;">
            <div class="location-label">${ctx.source === 'return' ? 'Destí de devolució' : 'Destí del producte'}</div>
            <div class="location-value">${p.aisle} · ${p.section} · ${p.shelf} · ${p.level}</div>
          </div>

          <div class="map-wrapper">
            <div class="map-toolbar">
              <span style="font-size:12px;font-weight:700;color:var(--blue-dark);">Vista superior 2D · ${store.name}</span>
              <div style="display:flex;gap:6px;">
                <button class="btn btn-outline btn-sm" onclick="adjustZoom(-0.2)">−</button>
                <button class="btn btn-outline btn-sm" onclick="adjustZoom(0.2)">+</button>
              </div>
            </div>
            <div class="map-viewport">
              ${renderStoreMapSVG(ctx.storeId, { targetZone: zone, singlePath: path, zoom: state.mapZoom })}
            </div>
            <div class="map-legend">
              <span class="legend-item"><span class="legend-swatch" style="background:#174A91;border-radius:50%;"></span> TU ETS AQUÍ</span>
              <span class="legend-item"><span class="legend-swatch" style="background:#246BCE;border-radius:50%;"></span> Destinació</span>
              <span class="legend-item"><span class="legend-swatch" style="background:#246BCE;height:4px;"></span> Ruta</span>
              <span class="legend-item"><span class="legend-swatch" style="background:#FDE68A;border:1px solid #D97706;"></span> Prestatgeries</span>
              <span class="legend-item"><span class="legend-swatch" style="background:#F8FAFC;border:1px solid #CBD5E1;"></span> Passadissos</span>
            </div>
          </div>

          ${ctx.source === 'search' ? `
            <button class="btn btn-light" style="margin-top:12px;" onclick='replaceView({ type: "directions", ctx: ${JSON.stringify(ctx)} })'>
              Veure indicacions escrites
            </button>
          ` : ''}

          ${actionFooter}
        </main>
      `;
    }

    function renderStoreMapOnly(view) {
      const store = STORES[view.storeId];
      return `
        ${renderTopBar('Mapa general', store.name)}
        <main class="main-content fade-in">
          <div class="map-wrapper">
            <div class="map-toolbar">
              <span style="font-size:12px;font-weight:700;color:var(--blue-dark);">Plànol complet · ${store.name}</span>
              <div style="display:flex;gap:6px;">
                <button class="btn btn-outline btn-sm" onclick="adjustZoom(-0.2)">−</button>
                <button class="btn btn-outline btn-sm" onclick="adjustZoom(0.2)">+</button>
              </div>
            </div>
            <div class="map-viewport">
              ${renderStoreMapSVG(view.storeId, { zoom: state.mapZoom })}
            </div>
            <div class="map-legend">
              <span class="legend-item"><span class="legend-swatch" style="background:#174A91;border-radius:50%;"></span> Entrada / TU ETS AQUÍ</span>
              <span class="legend-item"><span class="legend-swatch" style="background:#CBD5E1;"></span> Prestatgeries i zones</span>
            </div>
          </div>
        </main>
      `;
    }

    /* =========================================================================
       8. LLISTES DE COMPRA, OPTIMITZACIÓ AUTOMÀTICA I FLUX CONTINU
       ========================================================================= */
    function renderListsHome() {
      const storeCards = Object.values(STORES).map(s => {
        const items = state.lists[s.id] || [];
        const total = items.length;
        const found = items.filter(i => i.found).length;
        const pct = total > 0 ? Math.round((found / total) * 100) : 0;

        return `
          <div class="card" style="margin-bottom:12px;">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
              <div class="store-logo" style="background:${s.color};">${s.short}</div>
              <div style="flex:1;min-width:0;">
                <div style="font-size:16px;font-weight:800;">La meva llista de ${s.name}</div>
                <div style="font-size:13px;color:var(--text-secondary);">${total} productes · ${found} trobats (${pct}%)</div>
              </div>
            </div>
            <div class="progress-track" style="margin-bottom:12px;">
              <div class="progress-fill" style="width:${pct}%;"></div>
            </div>
            <button class="btn btn-light btn-sm" style="width:100%;" onclick="openListDetail('${s.id}')">
              Veure llista
            </button>
          </div>
        `;
      }).join('');

      const templatesHtml = state.templates.length === 0 ? '' : `
        <div class="section-label">Llistes guardades per a futures compres</div>
        ${state.templates.map(tpl => {
          const s = STORES[tpl.storeId];
          return `
            <div class="card" style="margin-bottom:10px;">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <div class="store-logo" style="width:38px;height:38px;font-size:13px;background:${s.color};">${s.short}</div>
                <div style="flex:1;">
                  <div style="font-size:15px;font-weight:700;">${tpl.name}</div>
                  <div style="font-size:12px;color:var(--text-secondary);">${s.name} · ${tpl.items.length} productes</div>
                </div>
              </div>
              <div class="btn-grid-2">
                <button class="btn btn-primary btn-sm" style="width:100%;" onclick="startFromTemplate('${tpl.id}')">Iniciar nova compra</button>
                <button class="btn btn-danger-outline btn-sm" style="width:100%;" onclick="deleteTemplate('${tpl.id}')">Eliminar plantilla</button>
              </div>
            </div>
          `;
        }).join('')}
      `;

      return `
        ${renderTopBar('Llistes de compra', 'Organitzades i optimitzades per establiment', false)}
        <main class="main-content fade-in">
          ${storeCards}
          ${templatesHtml}
        </main>
      `;
    }

    function openListDetail(storeId) {
      pushView({ type: 'listDetail', storeId, addQuery: '' });
    }

    function renderListDetail(view) {
      const { storeId, addQuery } = view;
      const store = STORES[storeId];
      const rawItems = state.lists[storeId] || [];
      const optimized = optimizeListItems(storeId, rawItems);

      const total = optimized.length;
      const foundCount = optimized.filter(i => i.found).length;
      const pct = total > 0 ? Math.round((foundCount / total) * 100) : 0;

      // Resultats de cerca per afegir productes del catàleg
      let addResultsHtml = '';
      if (addQuery && addQuery.trim().length > 0) {
        const res = smartSearchStore(storeId, addQuery);
        const catProds = res.categories.flatMap(c => CATALOGS[storeId].filter(p => p.category === c.name));
        const merged = [];
        const seenIds = new Set();
        [...res.products, ...catProds].forEach(p => {
          if (!seenIds.has(p.id)) { seenIds.add(p.id); merged.push(p); }
        });

        addResultsHtml = `
          <div class="card" style="margin-bottom:14px;border:1.5px solid var(--blue-primary);background:var(--blue-pale);">
            <div style="font-size:12px;font-weight:800;color:var(--blue-dark);margin-bottom:8px;">RESULTATS DEL CATÀLEG (${merged.length})</div>
            ${merged.length === 0 ? `<div style="font-size:13px;color:var(--text-secondary);">Cap coincidència a ${store.name}.</div>` : merged.slice(0, 8).map(p => {
              const variants = p.variants?.sizes
                ? p.variants.sizes.slice(0, 3).map(sz => `${sz}${p.variants.colors ? ' · ' + p.variants.colors[0] : ''}`)
                : [p.format];
              const priceText = typeof p.price === 'number' ? `${p.price.toFixed(2).replace('.', ',')} €` : p.price;

              return variants.map(vLabel => `
                <div style="background:#fff;border-radius:12px;padding:10px;display:flex;align-items:center;gap:10px;margin-bottom:8px;border:1px solid var(--border-soft);">
                  ${renderProductArt(storeId, p, 44)}
                  <div style="flex:1;min-width:0;">
                    <div style="font-size:13px;font-weight:700;">${p.name}</div>
                    <div style="font-size:11px;color:var(--text-secondary);">${p.brand} · ${vLabel} · ${priceText}</div>
                  </div>
                  <button class="btn btn-primary btn-sm" onclick="addProductToStoreList('${storeId}', '${p.id}', '${vLabel.replace(/'/g, "\\'")}', true)">Afegir</button>
                </div>
              `).join('');
            }).join('')}
          </div>
        `;
      }

      // Agrupació per passadís / zona amb ordre automàtic
      let lastGroupKey = null;
      const listHtml = optimized.map((item, idx) => {
        if (item.unlocatable) {
          return `
            <div class="product-row" style="border-color:#FECACA;background:#FEF2F2;">
              <div style="flex:1;">
                <div class="product-name">Producte no localitzable</div>
                <div class="product-meta">Sense ubicació definida al mapa</div>
              </div>
              <button class="btn btn-danger-outline btn-sm" onclick="removeListItem('${storeId}', '${item.uid}')">Eliminar</button>
            </div>
          `;
        }
        const p = item.product;
        const groupKey = `${p.aisle} — ${p.section.toUpperCase()}`;
        let groupHeader = '';
        if (groupKey !== lastGroupKey) {
          lastGroupKey = groupKey;
          groupHeader = `<div class="section-label" style="color:var(--blue-dark);margin-top:16px;">${groupKey}</div>`;
        }
        const priceText = typeof p.price === 'number' ? `${p.price.toFixed(2).replace('.', ',')} €` : p.price;

        return `
          ${groupHeader}
          <div class="product-row" style="opacity:${item.found ? '0.62' : '1'};cursor:default;">
            <div class="step-num" style="background:${item.found ? 'var(--success)' : 'var(--blue-primary)'};">${item.found ? '✓' : idx + 1}</div>
            ${renderProductArt(storeId, p, 50)}
            <div class="product-info">
              <div class="product-name" style="text-decoration:${item.found ? 'line-through' : 'none'};">${p.name}</div>
              <div class="product-meta">${p.brand} · ${item.variantLabel || p.format} · ${priceText}</div>
              <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                <span style="font-size:11px;font-weight:700;color:var(--blue-primary);">${p.shelf} · ${p.level}</span>
                <span class="badge ${item.found ? 'badge-avail' : 'badge-low'}">${item.found ? 'Trobat' : 'Pendent'}</span>
              </div>
            </div>
            <button class="btn-icon" onclick="removeListItem('${storeId}', '${item.uid}')" title="Eliminar de la llista" style="width:32px;height:32px;color:var(--danger);border-color:#FECACA;">
              ×
            </button>
          </div>
        `;
      }).join('');

      const hasPending = optimized.some(i => !i.found && !i.unlocatable);

      return `
        ${renderTopBar(`Llista de ${store.name}`, `${total} productes · Ordre optimitzat automàticament`)}
        <main class="main-content fade-in">
          <div class="card" style="margin-bottom:14px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
              <span style="font-size:14px;font-weight:800;">Progrés de la compra</span>
              <span style="font-size:14px;font-weight:800;color:var(--blue-primary);">${foundCount} / ${total} (${pct}%)</span>
            </div>
            <div class="progress-track" style="margin-bottom:12px;">
              <div class="progress-fill" style="width:${pct}%;"></div>
            </div>

            ${total > 0 ? `
              <div style="display:flex;flex-direction:column;gap:8px;">
                ${hasPending ? `
                  <button class="btn btn-primary" onclick="startListTour('${storeId}')">
                    ${state.activeTour?.storeId === storeId && state.activeTour?.paused ? 'REPRENDRE RECORREGUT' : 'COMENÇAR RECORREGUT'}
                  </button>
                ` : `
                  <button class="btn btn-success" onclick="pushView({ type: 'listComplete', storeId: '${storeId}' })">
                    VEURE RESUM DE FINALITZACIÓ
                  </button>
                `}
                <button class="btn btn-light" onclick="pushView({ type: 'fullListMap', storeId: '${storeId}' })">
                  Veure mapa del recorregut complet
                </button>
              </div>
            ` : ''}
          </div>

          <!-- Camp per afegir productes -->
          <div class="search-box">
            <span class="search-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </span>
            <input id="listAddInput" class="search-input" type="text" placeholder="Quin producte vols afegir?"
              value="${addQuery || ''}" oninput="updateListAddQuery(this.value)" />
            ${addQuery ? `<button class="search-clear" onclick="updateListAddQuery('')">×</button>` : ''}
          </div>

          ${addResultsHtml}

          ${total === 0 ? `
            <div class="empty-state">La teva llista de ${store.name} és buida. Cerca productes o categories a dalt per afegir-los i FINDIT optimitzarà el recorregut automàticament.</div>
          ` : listHtml}
        </main>
      `;
    }

    function renderFullListMap(view) {
      const { storeId } = view;
      const store = STORES[storeId];
      const optimized = optimizeListItems(storeId, state.lists[storeId] || []).filter(i => !i.unlocatable);
      const stops = optimized.map((item, idx) => ({
        zone: item.zone,
        index: idx + 1,
        found: item.found,
        label: item.product.name
      }));

      return `
        ${renderTopBar('Mapa del recorregut complet', `${store.name} · ${stops.length} parades optimitzades`)}
        <main class="main-content fade-in">
          <div class="map-wrapper" style="margin-bottom:14px;">
            <div class="map-toolbar">
              <span style="font-size:12px;font-weight:700;color:var(--blue-dark);">Ruta completa optimitzada</span>
              <div style="display:flex;gap:6px;">
                <button class="btn btn-outline btn-sm" onclick="adjustZoom(-0.2)">−</button>
                <button class="btn btn-outline btn-sm" onclick="adjustZoom(0.2)">+</button>
              </div>
            </div>
            <div class="map-viewport">
              ${renderStoreMapSVG(storeId, { multiStops: stops, zoom: state.mapZoom })}
            </div>
            <div class="map-legend">
              <span class="legend-item"><span class="legend-swatch" style="background:#174A91;border-radius:50%;"></span> Entrada</span>
              <span class="legend-item"><span class="legend-swatch" style="background:#246BCE;border-radius:50%;"></span> Pendent</span>
              <span class="legend-item"><span class="legend-swatch" style="background:#16A34A;border-radius:50%;"></span> Trobat</span>
              <span class="legend-item"><span class="legend-swatch" style="background:#246BCE;height:4px;"></span> Ruta completa</span>
            </div>
          </div>

          <div class="section-label">Ordre de parades del recorregut</div>
          ${optimized.map((item, idx) => `
            <div class="step-item" style="padding:10px 12px;opacity:${item.found ? '0.6' : '1'};">
              <div class="step-num" style="background:${item.found ? 'var(--success)' : 'var(--blue-primary)'};">${item.found ? '✓' : idx + 1}</div>
              <div style="flex:1;">
                <div style="font-size:14px;font-weight:700;">${item.product.name}</div>
                <div style="font-size:12px;color:var(--text-secondary);">${item.product.aisle} · ${item.product.shelf} · ${item.found ? 'Trobat' : 'Pendent'}</div>
              </div>
            </div>
          `).join('')}
        </main>
      `;
    }

    function startListTour(storeId) {
      const optimized = optimizeListItems(storeId, state.lists[storeId] || []);
      const pending = optimized.filter(i => !i.found && !i.unlocatable);
      if (pending.length === 0) {
        pushView({ type: 'listComplete', storeId });
        return;
      }
      const resumeUid = (state.activeTour?.storeId === storeId && pending.some(i => i.uid === state.activeTour.currentUid))
        ? state.activeTour.currentUid
        : pending[0].uid;

      state.activeTour = { storeId, currentUid: resumeUid, paused: false };
      saveState();
      pushView({ type: 'listTour', storeId });
    }

    function renderListTour(view) {
      const { storeId } = view;
      const store = STORES[storeId];
      const optimized = optimizeListItems(storeId, state.lists[storeId] || []).filter(i => !i.unlocatable);
      const total = optimized.length;
      const foundCount = optimized.filter(i => i.found).length;
      const pct = total > 0 ? Math.round((foundCount / total) * 100) : 0;

      const currentIdx = optimized.findIndex(i => i.uid === state.activeTour?.currentUid && !i.found);
      const currentItem = currentIdx >= 0 ? optimized[currentIdx] : optimized.find(i => !i.found);

      if (!currentItem) {
        setTimeout(() => replaceView({ type: 'listComplete', storeId }), 0);
        return '';
      }

      const displayPos = optimized.findIndex(i => i.uid === currentItem.uid) + 1;
      const p = currentItem.product;
      const priceText = typeof p.price === 'number' ? `${p.price.toFixed(2).replace('.', ',')} €` : p.price;
      const ctx = { source: 'list', storeId, itemUid: currentItem.uid, productId: p.id };

      return `
        ${renderTopBar(`Recorregut · ${store.name}`, `Producte ${displayPos} de ${total}`)}
