          </div>

          <div class="section-label">Resum dels productes (${total})</div>
          ${items.map(i => `
            <div class="step-item" style="padding:10px 12px;align-items:center;">
              <div class="step-num" style="background:var(--success);width:26px;height:26px;font-size:12px;">✓</div>
              <div style="flex:1;font-size:13px;font-weight:700;">${i.product ? i.product.name : 'Producte'}</div>
